rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny all
    match /{document=**} {
      allow read, write: if false;
    }

    function signedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    // Users collection — each user can only access their own document.
    // Plan fields (isPro, proExpiresAt, subscriptionPlan, paymentDetails, ...) can NOT be written
    // from the website or extension. Only the Firebase console / Admin SDK can change them
    // (security rules do not apply there), so nobody can grant themselves Pro.
    match /users/{userId} {
      allow read: if isOwner(userId);

      // First sign-in: create the profile doc, always as a Free account
      allow create: if isOwner(userId)
        && request.resource.data.keys().hasOnly(['uid', 'email', 'displayName', 'photoURL', 'isPro', 'createdAt'])
        && request.resource.data.get('isPro', false) == false
        && request.resource.data.get('uid', userId) == userId;

      // Later edits: only basic profile info
      allow update: if isOwner(userId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['email', 'displayName', 'photoURL']);

      allow delete: if false;
    }

    // PayPal payment claims — created after PayPal checkout, reviewed manually by the owner.
    // Users can only create "pending" claims for themselves and read their own. Approving happens
    // in the Firebase console (set users/{uid}.isPro + proExpiresAt, then mark the claim approved).
    // The doc id must be "paypal_<orderId>", so each PayPal transaction can be claimed only once
    // (a second create on an existing id is an update, which is denied).
    // GCash / Maya / QR Ph no longer use claims: /api/paymongo activates Pro server-side.
    match /paymentClaims/{claimId} {
      allow read: if signedIn() && resource.data.uid == request.auth.uid;
      allow create: if signedIn()
        && validClaim(request.resource.data)
        && claimId == request.resource.data.provider + '_' + request.resource.data.orderId;
      allow update, delete: if false;
    }

    function validClaim(d) {
      return d.keys().hasOnly(['uid', 'email', 'provider', 'orderId', 'payerEmail', 'amount', 'currency', 'status', 'note', 'createdAt'])
        && d.uid == request.auth.uid
        && d.status == 'pending'
        && d.provider == 'paypal'
        && d.email is string && d.email.size() <= 200
        && d.orderId is string && d.orderId.matches('^[A-Za-z0-9-]{5,64}$')
        && d.get('payerEmail', '') is string && d.get('payerEmail', '').size() <= 200
        && d.get('amount', '') is string && d.get('amount', '').size() <= 20
        && d.get('currency', '') is string && d.get('currency', '').size() <= 10
        && d.get('note', '') is string && d.get('note', '').size() <= 200
        && d.createdAt == request.time;
    }

    // PayMongo payment ledger (one doc per pay_... id) and open checkout per user.
    // Written only by /api/paymongo with the Admin SDK; users may read their own payments.
    match /payments/{paymentId} {
      allow read: if signedIn() && resource.data.uid == request.auth.uid;
      allow write: if false;
    }

    match /checkoutSessions/{userId} {
      allow read, write: if false;
    }

    match /reviews/{userId} {
      // Anyone can read reviews
      allow read: if true;

      // Allow users to write their own review
      // The document ID must match the authenticated user's ID
      allow write: if request.auth != null
                   && request.auth.uid == userId
                   && validateReview(request.resource.data);
    }

    // Function to validate the review shape and sizes, preventing massive spam payloads
    function validateReview(data) {
      return data.keys().hasAll(['username', 'rating', 'feedback', 'createdAt'])
        && data.username is string
        && data.username.size() > 0
        && data.username.size() <= 50
        && data.rating is number
        && data.rating >= 1
        && data.rating <= 5
        && data.feedback is string
        && data.feedback.size() <= 1000;
    }
  }
}
